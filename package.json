{
  "name": "creator-imagine-engine",
  "version": "1.0.0",
  "description": "Motor audiovisual para CREATOR IMAGINE — Canal YouTube",
  "private": true,
  "scripts": {
    "setup:browser": "playwright install chromium",
    "setup": "npm install && npm run setup:browser",
    "build": "python scripts/build_video.py",
    "test:smoke": "python scripts/build_video.py examples/cloud_smoke_test",
    "test:system": "python scripts/build_video.py examples/system_test",
    "validate": "node scripts/validate_timeline.js",
    "preview": "node scripts/render_preview.js",
    "render": "node scripts/render_final.js",
    "quality": "python scripts/quality_check.py",
    "test": "npm run validate"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "playwright": "^1.55.0",
    "chalk": "^4.1.2",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
